{
  "applications": [
    {
      "id": "docker-desktop",
      "name": "Docker Desktop",
      "url": "https://your-bucket/docker-desktop-installer.exe",
      "installer_type": "exe",
      "args": "/quiet",
      "version": "4.26.1",
      "commands": [
        "Start-Sleep -Seconds 5",
        "$data = Get-Content -Path 'C:\\Users\\$env:USERNAME\\AppData\\Roaming\\Docker\\settings.json' -Raw | ConvertFrom-Json",
        "$data.kubernetes.enabled = $true",
        "$data.integratedWslDistros += \"Ubuntu-20.04\"",
        "$data | ConvertTo-Json | Set-Content -Path 'C:\\Users\\$env:USERNAME\\AppData\\Roaming\\Docker\\settings.json'",
        "wsl -e bash -c \"curl https://your-bucket/docker-images-setup.sh | bash\""
      ]
    },
    {
      "id": "ubuntu",
      "name": "Ubuntu",
      "url": "https://your-bucket/ubuntu.zip",
      "installer_type": "zip",
      "version": "22.04",
      "add_to_path": false
    },
    {
      "id": "wsl-updater",
      "name": "WSL Updater",
      "url": "https://your-bucket/wsl-updater.msi",
      "installer_type": "msi",
      "args": "/quiet /norestart",
      "version": "1.0"
    },
    {
      "id": "wsl",
      "name": "Windows Subsystem for Linux (WSL)",
      "url": "https://your-bucket/wsl.msi",
      "installer_type": "msi",
      "args": "/quiet /norestart",
      "version": "2.0",
      "commands": [
        "Write-Host 'NOTICE: Ubuntu will now open in a new window. You will need to create a username and password.' -ForegroundColor Yellow",
        "Start-Sleep -Seconds 3",
        "Start-Process -FilePath 'C:\\C:\\Program Files\\ubuntu\\ubuntu.exe' -Wait",
        "wsl -s Ubuntu-20.04",
        "wsl -e bash -c \"curl https://your-bucket/install-wsl-setup.sh | bash\"",
        "wsl -e bash -c 'source ~/.bashrc'"
      ]
    },
    {
      "id": "helm",
      "name": "Helm",
      "url": "https://your-bucket/helm-windows-amd64.zip",
      "installer_type": "zip",
      "version": "3.13.2",
      "add_to_path": true
    },
    {
      "id": "kubernetes-cli",
      "name": "Kubernetes CLI (kubectl)",
      "url": "https://your-bucket/kubectl.exe",
      "installer_type": "exe",
      "args": "",
      "version": "1.29.1"
    },
    {
      "id": "maven",
      "name": "Apache Maven",
      "url": "https://your-bucket/apache-maven.zip",
      "installer_type": "zip",
      "version": "3.9.6",
      "add_to_path": true,
      "env_vars": ["MAVEN_HOME", "M2_HOME"]
    },
    {
      "id": "intellij",
      "name": "IntelliJ IDEA Community",
      "url": "https://your-bucket/ideaIC.exe",
      "installer_type": "exe",
      "args": "/S",
      "version": "2023.3.2"
    },
    {
      "id": "pycharm",
      "name": "PyCharm Community",
      "url": "https://your-bucket/pycharm-community.exe",
      "installer_type": "exe",
      "args": "/S",
      "version": "2023.3.2"
    },
    {
      "id": "postman",
      "name": "Postman",
      "url": "https://your-bucket/Postman-win64.exe",
      "installer_type": "exe",
      "args": "/S",
      "version": "10.20.0"
    },
    {
      "id": "vscode",
      "name": "Visual Studio Code",
      "url": "https://your-bucket/VSCodeUserSetup-x64.exe",
      "installer_type": "exe",
      "args": "/verysilent",
      "version": "1.85.2"
    },
    {
      "id": "python",
      "name": "Python 3.x",
      "url": "https://your-bucket/python-3.x.exe",
      "installer_type": "exe",
      "args": "/quiet InstallAllUsers=1 PrependPath=1",
      "version": "3.12.1"
    },
    {
      "id": "datagrip",
      "name": "DataGrip",
      "url": "https://your-bucket/datagrip.exe",
      "installer_type": "exe",
      "args": "/S",
      "version": "2023.3.2"
    },
    {
      "id": "gitkraken",
      "name": "GitKraken",
      "url": "https://your-bucket/gitkraken.exe",
      "installer_type": "exe",
      "args": "/S",
      "version": "9.1.0"
    },
    {
      "id": "nodejs",
      "name": "Node.js LTS",
      "url": "https://your-bucket/node-vX.Y.Z-x64.msi",
      "installer_type": "msi",
      "args": "/quiet /norestart",
      "version": "20.10.0"
    },
    {
      "id": "java",
      "name": "Java JDK",
      "url": "https://your-bucket/jdk-X.Y.Z-windows-x64.zip",
      "installer_type": "zip",
      "version": "21.0.1",
      "add_to_path": true,
      "env_vars": ["JAVA_HOME"]
    },
    {
      "id": "tilt",
      "name": "Tilt",
      "url": "https://your-bucket/tilt.exe",
      "installer_type": "exe",
      "args": "",
      "version": "0.33.9"
    }
  ]
}